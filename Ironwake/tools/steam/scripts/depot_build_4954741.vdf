"DepotBuild"
{
	"DepotID" "4954741"

	// Take everything in the content folder, preserving structure.
	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"recursive" "1"
	}

	// Never ship these: steam_appid.txt is a local-dev override that breaks the
	// "launch through Steam" flow for customers; pdb/log files are dev noise.
	"FileExclusion" "*.pdb"
	"FileExclusion" "steam_appid.txt"
	"FileExclusion" "*.log"
	// Stray Steam shortcut to an UNRELATED game (appid 1159290) that rides along in
	// the GameMaker export - it lives in the project's Included Files and points at
	// M's local Steam .ico path. Never ship it. Remove it from Included Files to stop
	// it at the source too. (Found 07-20 in the first real build.)
	"FileExclusion" "*.url"
}

